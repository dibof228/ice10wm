ColorMEMStatusCached=                   "rgb:8a/00/b4"
ColorMEMStatusUser=                     "rgb:8a/00/b4"
ColorMEMStatusBuffers=                  "rgb:8a/00/b4"

#Input
ColorInput=                             "rgb:ff/ff/ff"
ColorInputText=                         "rgb:00/00/00"
ColorInputSelection=                    "rgb:42/99/ff"
ColorInputSelectionText=                "rgb:ff/ff/ff"

#ScrollBar
ColorScrollBar=                         "rgb:f0/f0/f0"
ColorScrollBarButton=                   "rgb:d6/d6/d6"
