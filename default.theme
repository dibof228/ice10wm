StatusFontNameXft=                      "sans-serif:size=9"
MenuFontNameXft=                        "sans-serif:size=9"
NormalTaskBarFontNameXft=               "sans-serif:size=9"
ActiveTaskBarFontNameXft=               "sans-serif:size=9"
NormalWorkspaceFontNameXft=             "sans-serif:size=9"
ActiveWorkspaceFontNameXft=             "sans-serif:size=9"
ListBoxFontNameXft=                     "sans-serif:size=9"
ToolTipFontNameXft=                     "sans-serif:size=9"
LabelFontNameXft=                       "sans-serif:size=9"
InputFontNameXft=                       "sans-serif:size=9"
ActiveButtonFontNameXft=                "sans-serif:size=9"
NormalButtonFontNameXft=                "sans-serif:size=9"
QuickSwitchFontNameXft=                 "sans-serif:size=9"
ClockFontNameXft=                       "sans-serif:size=9"

#Desktop
DesktopBackgroundColor=                 "rgb:00/00/00"
DesktopTransparencyColor=               "rgb:00/00/00"
DesktopBackgroundCenter=                0
DesktopBackgroundScaled=                1
DesktopBackgroundImage=                 "default.jpg"
